# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon or any Postgres instance with PostGIS enabled).
DATABASE_URL=

# Auth.js session encryption secret — generate a strong, unique random value
# per environment (e.g. `openssl rand -base64 32`). Never reuse across environments.
AUTH_SECRET=

# Must be "true" to allow demo dataset seeding (scripts/seed-demo-routing.ts,
# scripts/seed-demo-roles.ts, the /settings demo-data section). Leave unset or
# "false" in any environment that holds real municipal data, production included.
DEMO_MODE=false

# Required only when running scripts/seed-demo-roles.ts. No default is used —
# the script refuses to run without this set explicitly.
SEED_DEMO_PASSWORD=
