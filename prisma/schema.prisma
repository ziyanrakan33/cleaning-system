// Prisma schema — מערכת ניהול תוכנית ניקיון עירונית, כפר סבא
// Geometry columns (PostGIS) are declared as Unsupported() — Prisma Client
// cannot read/write them directly; all spatial reads/writes go through
// src/server/geo.service.ts using $queryRaw / $executeRaw (ST_* functions).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// ---------- Enums ----------

enum UserRole {
  ADMIN
  // MANAGER is the legacy pre-tender role. No rows use it, but several route
  // handlers still test for it, so it stays as an alias of DEPT_MANAGER.
  MANAGER
  EMPLOYEE
  CITY_MANAGER
  DEPT_MANAGER
  INSPECTOR
  CONTRACTOR_MANAGER
  SITE_SUPERVISOR
  VIEWER
  FINANCE
}

/// Lifecycle of a value extracted from a tender document or photographed table.
/// Nothing below VERIFIED may be presented to the user as established fact.
enum VerificationStatus {
  EXTRACTED
  REQUIRES_REVIEW
  VERIFIED
  REJECTED
  CONFLICTED
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum SourceType {
  TENDER_DOCUMENT
  BID_TABLE_IMAGE
  ZONE_MAP_IMAGE
  GIS_IMPORT
  OSM_IMPORT
  MANUAL_ENTRY
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  REST_DAY
  FLEXIBLE
}

enum ResourceCategory {
  SWEEPER_SMALL
  SWEEPER_MEDIUM
  SWEEPER_LARGE
  TASK_VEHICLE
  MIUL
  MANUAL_WORKER
  WASHER
  TRIMMER
  SUPERVISOR
  OTHER
}

enum ConflictStatus {
  OPEN
  RESOLVED
  ACCEPTED_BOTH
}

/// Defect lifecycle. Mirrors the contract: the contractor fixes at his own
/// expense by the deadline (§821), may appeal the monthly deduction list within
/// 7 days (§826), and nothing closes without the inspector accepting the proof.
enum DefectStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  AWAITING_PROOF
  FIXED
  REJECTED
  APPEALED
  CLOSED
}

enum DefectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DefectOrigin {
  INSPECTION
  CALL_CENTER
  MANAGER
  CONTRACTOR
  OTHER
}

/// A deduction is only ever *proposed* by the system. §825 puts the decision
/// with the מנהל, so it takes an explicit approval before it counts.
enum DeductionStatus {
  NONE
  PROPOSED
  APPROVED
  WAIVED
  APPLIED
}

enum PhotoKind {
  BEFORE
  AFTER
}

enum ComplaintStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
}

enum InspectionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// §561 fixes two daily rounds, at 10:00 and at 12:00.
enum InspectionRound {
  MORNING_10
  MIDDAY_12
  AD_HOC
}

enum StreetType {
  STREET
  PATH
  PEDESTRIAN_MALL
  PUBLIC_AREA
  OTHER
}

enum Priority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum FrequencyType {
  DAILY
  TIMES_PER_WEEK
  WEEKLY
  SPECIFIC_DAYS
  AS_NEEDED
}

enum DataSource {
  OSM
  MANUAL
}

enum ResourceStatus {
  ACTIVE
  BROKEN
  MAINTENANCE
  INACTIVE
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  BROKEN
  MAINTENANCE
}

enum WorkPlanStatus {
  DRAFT
  CONFIRMED
  ARCHIVED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  NOT_DONE
  PROBLEM
}

// ---------- Smart cleaning / routing enums ----------

/// How much of a cleaning profile's numbers come from the field rather than
/// from a guess. The whole point of the ladder is that the UI can always say
/// which rung a recommendation stands on instead of presenting all of them as
/// equally solid.
enum ProfileDataMode {
  /// No survey filled in yet — nothing to base a recommendation on.
  REQUIRES_REVIEW
  /// The supervisor's own estimate, and nothing else.
  MANUAL_BASELINE
  /// A complete profile scored by the published, editable weights.
  RULE_BASED
  /// Enough completed jobs on this segment that measured averages lead.
  DATA_INFORMED
}

enum ServicePointStatus {
  ACTIVE
  BROKEN
  TEMPORARILY_CLOSED
  REQUIRES_REVIEW
}

enum ServiceStopKind {
  WATER_REFILL
  WASTE_DISPOSAL
  BREAK
}

/// Whether a computed figure rests on measured history or on a default.
/// Never inferred at render time — the engine stamps it.
enum CalcBasis {
  ESTIMATED
  MEASURED
}

/// Basis of a routing distance: the real OSM road-network graph, or a
/// straight-line fallback used only when the graph lookup fails.
enum DistanceBasis {
  ROAD_NETWORK
  STRAIGHT_LINE
}

/// Why a field task ended NOT_DONE or PROBLEM — see TaskFieldReport.nonCompletionReason.
enum NonCompletionReason {
  BLOCKED
  WATER_SHORTAGE
  ACCESS_ISSUE
  VEHICLE_UNSUITABLE
  DEFECT
  OTHER
}

enum SurveyProgress {
  COMPLETED
  NEEDS_RECHECK
}

enum FieldPhotoKind {
  BEFORE
  AFTER
  GENERAL
}

enum ImportType {
  STREETS
  RESOURCES
}

enum ImportStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
}

// ---------- Core entities ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(EMPLOYEE)
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// Which of the two contract areas a contractor-side account (CONTRACTOR_MANAGER,
  /// SITE_SUPERVISOR) is restricted to. Null means "not yet assigned" for those
  /// roles — which must show nothing until set, never everything. Ignored for
  /// every other role; do not repurpose this for general zone assignment.
  contractAreaId String?       @map("contract_area_id")
  contractArea   ContractArea? @relation(fields: [contractAreaId], references: [id], onDelete: SetNull)

  /// Brute-force throttle on the credentials login — see src/lib/auth.ts.
  /// Reset to 0 on any successful login. No external rate-limit store exists
  /// yet (see docs/EXTERNAL_INTEGRATIONS.md), so this is a simple in-DB
  /// per-account counter rather than a per-IP one.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")

  // an employee may be permanently assigned to one or more resources
  assignedResources Resource[]        @relation("ResourceEmployee")
  createdWorkPlans  WorkPlan[]        @relation("WorkPlanCreatedBy")
  workPlanChanges   WorkPlanChange[]  @relation("WorkPlanChangeBy")
  importBatches     ImportBatch[]     @relation("ImportedBy")
  verifiedEvidence  SourceEvidence[]  @relation("EvidenceVerifiedBy")
  resolvedConflicts SourceConflict[]  @relation("ConflictResolvedBy")
  manualOverrides   ManualOverride[]  @relation("OverrideBy")
  auditLogs         AuditLog[]        @relation("AuditBy")

  reportedDefects     Defect[]      @relation("DefectReportedBy")
  assignedDefects     Defect[]      @relation("DefectAssignedTo")
  approvedDeductions  Defect[]      @relation("DeductionApprovedBy")
  decidedAppeals      Defect[]      @relation("AppealDecidedBy")
  defectEvents        DefectEvent[] @relation("DefectEventBy")
  uploadedPhotos      DefectPhoto[] @relation("PhotoUploadedBy")
  receivedComplaints  Complaint[]   @relation("ComplaintReceivedBy")
  assignedComplaints  Complaint[]   @relation("ComplaintAssignedTo")
  inspections         Inspection[]  @relation("InspectionInspector")
  attendedInspections Inspection[]  @relation("InspectionContractorRep")

  settingsChanged        SystemSetting[]        @relation("SettingUpdatedBy")
  surveys                StreetSurvey[]         @relation("SurveyBy")
  shiftReports           ShiftReport[]          @relation("ShiftReportBy")
  taskFieldReports       TaskFieldReport[]      @relation("FieldReportBy")
  uploadedFieldPhotos    FieldPhoto[]           @relation("FieldPhotoUploadedBy")
  excludedLearningEvents ProfileLearningEvent[] @relation("LearningSampleExcludedBy")
  approvedPlanOverrides  WorkPlan[]             @relation("PlanOverrideApprovedBy")
  cancelledPlans         WorkPlan[]             @relation("PlanCancelledBy")
  createdZones           OperationalZone[]      @relation("ZoneCreatedBy")
  createdStreets         Street[]               @relation("StreetCreatedBy")

  @@index([contractAreaId])
  @@map("users")
}

// ---------- Tender / contract layer ----------
// A ContractArea is a CONTRACTUAL construct: there are exactly two, one per
// winning contractor. It is NOT the same thing as an OperationalZone (of which
// there are ten). The two must never share a table or a column.

model Tender {
  id           String  @id @default(cuid())
  name         String
  number       String?
  description  String?
  municipality String  @default("כפר סבא")

  contractMonths Int? @map("contract_months")
  optionYears    Int? @map("option_years")

  // Tender-stated estimates. They disagree with each other and with the OSM
  // import; the difference is recorded as a SourceConflict rather than resolved.
  totalInfrastructureKm Float? @map("total_infrastructure_km")
  jurisdictionKm        Float? @map("jurisdiction_km")

  // The municipality may shrink the work by up to 25% or grow it by up to 50%.
  maxDecreasePercent Int? @map("max_decrease_percent")
  maxIncreasePercent Int? @map("max_increase_percent")

  sourceFile String? @map("source_file")
  notes      String?

  contractAreas ContractArea[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenders")
}

model Contractor {
  id                 String  @id @default(cuid())
  name               String  @unique
  registrationNumber String? @map("registration_number")
  contactName        String? @map("contact_name")
  contactPhone       String? @map("contact_phone")
  contactEmail       String? @map("contact_email")
  active             Boolean @default(true)
  notes              String?

  contractAreas ContractArea[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contractors")
}

model ContractArea {
  id         String @id @default(cuid())
  areaNumber Int    @unique @map("area_number") // 1 or 2
  name       String

  tenderId String? @map("tender_id")
  tender   Tender? @relation(fields: [tenderId], references: [id], onDelete: SetNull)

  contractorId String?     @map("contractor_id")
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  verificationStatus VerificationStatus @default(EXTRACTED) @map("verification_status")
  confidence         ConfidenceLevel    @default(MEDIUM)

  dailyTotal   Decimal? @map("daily_total") @db.Decimal(14, 2)
  monthlyTotal Decimal? @map("monthly_total") @db.Decimal(14, 2)
  annualTotal  Decimal? @map("annual_total") @db.Decimal(14, 2)

  notes String?

  quotas           ContractAreaResourceQuota[]
  operationalZones OperationalZone[]
  defects          Defect[]
  users            User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contract_areas")
}

/// One row of a winning contractor's priced resource table, for one contract area.
model ContractAreaResourceQuota {
  id String @id @default(cuid())

  contractAreaId String       @map("contract_area_id")
  contractArea   ContractArea @relation(fields: [contractAreaId], references: [id], onDelete: Cascade)

  resourceTypeId String       @map("resource_type_id")
  resourceType   ResourceType @relation(fields: [resourceTypeId], references: [id])

  /// מס"ד as printed in THIS area's table — the two areas number their rows differently.
  lineNumber Int   @map("line_number")
  quantity   Int
  shiftHours Float @map("shift_hours")

  maxUnitPrice Decimal? @map("max_unit_price") @db.Decimal(12, 2)
  unitPrice    Decimal? @map("unit_price") @db.Decimal(12, 2)
  dailyTotal   Decimal? @map("daily_total") @db.Decimal(14, 2)

  /// City-wide quantity from the tender's own table 17. Kept alongside the
  /// per-area figure rather than replacing it — the two often disagree.
  tenderQuantity Int? @map("tender_quantity")

  verificationStatus VerificationStatus @default(EXTRACTED) @map("verification_status")
  confidence         ConfidenceLevel    @default(MEDIUM)
  notes              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([contractAreaId, lineNumber])
  @@index([resourceTypeId])
  @@map("contract_area_resource_quotas")
}

// ---------- Operational geography ----------
// An OperationalZone is one of the ten cleaning zones drawn on the city map.
// Its link to a ContractArea is deliberately nullable: the tender draft leaves
// the "קבלן מס' 1:" / "קבלן מס' 2:" zone lists blank, so the mapping cannot be
// derived from any source and must be set by a manager.

model OperationalZone {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  color       String  @default("#2563eb")
  description String?
  active      Boolean @default(true)

  /// 1..10 as printed on the zone map. Null for legacy/ad-hoc zones.
  zoneNumber Int? @unique @map("zone_number")

  contractAreaId String?       @map("contract_area_id")
  contractArea   ContractArea? @relation(fields: [contractAreaId], references: [id], onDelete: SetNull)

  /// Whether the zone→contract-area link has been confirmed by a human.
  contractAreaStatus VerificationStatus @default(REQUIRES_REVIEW) @map("contract_area_status")

  /// Whether the zone's boundary geometry has been confirmed.
  verificationStatus VerificationStatus @default(REQUIRES_REVIEW) @map("verification_status")
  confidence         ConfidenceLevel    @default(LOW)
  manuallyOverridden Boolean            @default(false) @map("manually_overridden")
  notes              String?

  /// Demo rows are visible and usable, but never counted in savings, learning
  /// or KPI figures — a fabricated improvement is worse than no figure at all.
  isDemo Boolean @default(false) @map("is_demo")

  /// Who created this zone record — null for zones that predate this field.
  createdById String? @map("created_by")
  createdBy   User?   @relation("ZoneCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // geometry(Polygon, 4326) — accessed via geo.service.ts raw SQL
  geometry Unsupported("geometry(Polygon, 4326)")?

  streets           Street[]
  segments          StreetSegment[]
  allowedByResource Resource[]      @relation("ResourceAllowedZones")
  defects           Defect[]
  complaints        Complaint[]
  inspections       Inspection[]

  waterRefillPoints   WaterRefillPoint[]
  wasteDisposalPoints WasteDisposalPoint[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("zones")
}

model Street {
  id                    String           @id @default(cuid())
  name                  String
  type                  StreetType       @default(STREET)
  zoneId                String?          @map("zone_id")
  zone                  OperationalZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  lengthM               Float?           @map("length_m")
  startPointLat         Float?        @map("start_point_lat")
  startPointLon         Float?        @map("start_point_lon")
  endPointLat            Float?        @map("end_point_lat")
  endPointLon            Float?        @map("end_point_lon")

  // geometry(LineString, 4326) — accessed via geo.service.ts raw SQL
  geometry Unsupported("geometry(LineString, 4326)")?

  priority              Priority      @default(NORMAL)
  cleaningFrequency     Json          @map("cleaning_frequency")
  // e.g. {"type":"TIMES_PER_WEEK","timesPerWeek":2} | {"type":"SPECIFIC_DAYS","days":["SUN","WED"]}

  estimatedCleanMinutes Int?          @map("estimated_clean_minutes")
  notes                 String?
  active                Boolean       @default(true)
  source                DataSource    @default(MANUAL)
  osmId                 String?       @unique @map("osm_id")

  /// True when the street's geometry falls inside more than one zone, so it is
  /// represented by several StreetSegments rather than a single zone link.
  crossesZones          Boolean       @default(false) @map("crosses_zones")

  /// See OperationalZone.isDemo.
  isDemo Boolean @default(false) @map("is_demo")

  /// Who created this street record — null for streets that predate this field.
  createdById String? @map("created_by")
  createdBy   User?   @relation("StreetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  allowedResourceTypes  ResourceType[]        @relation("StreetAllowedResourceTypes")
  allowedByResource     Resource[]            @relation("ResourceAllowedStreets")
  workPlanTasks         WorkPlanTask[]
  cleaningLogs          StreetCleaningLog[]
  segments              StreetSegment[]
  defects               Defect[]
  complaints            Complaint[]

  cleaningProfile StreetCleaningProfile?
  surveys         StreetSurvey[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([zoneId])
  @@map("streets")
}

/// The part of one street that falls inside one zone. Produced by the spatial
/// join (ST_Intersection); a street crossing a boundary yields several rows so
/// that its length is attributed to the right zone instead of being assigned
/// wholesale by its midpoint.
model StreetSegment {
  id String @id @default(cuid())

  streetId String @map("street_id")
  street   Street @relation(fields: [streetId], references: [id], onDelete: Cascade)

  zoneId String?          @map("zone_id")
  zone   OperationalZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  segmentIndex Int    @map("segment_index")
  lengthM      Float? @map("length_m")

  // geometry(LineString, 4326) — accessed via geo.service.ts raw SQL
  geometry Unsupported("geometry(LineString, 4326)")?

  verificationStatus VerificationStatus @default(EXTRACTED) @map("verification_status")
  confidence         ConfidenceLevel    @default(MEDIUM)

  /// Set when a manager corrects the zone by hand. The spatial join must never
  /// overwrite a row with this flag on a later run.
  manuallyOverridden Boolean @default(false) @map("manually_overridden")
  crossesZones       Boolean @default(false) @map("crosses_zones")
  notes              String?

  defects Defect[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([streetId, segmentIndex])
  @@index([zoneId])
  @@index([verificationStatus])
  @@map("street_segments")
}

model ResourceType {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  /// Catalog attributes, so a manager can add a resource type without a code change.
  category            ResourceCategory @default(OTHER)
  shiftType           ShiftType        @default(FLEXIBLE) @map("shift_type")
  standardHours       Float?           @map("standard_hours")
  capacityLiters      Int?             @map("capacity_liters")
  requiresDriver      Boolean          @default(false) @map("requires_driver")
  requiresExtraWorker Boolean          @default(false) @map("requires_extra_worker")
  requiresGps         Boolean          @default(false) @map("requires_gps")
  suitableForRoad     Boolean          @default(true) @map("suitable_for_road")
  suitableForSidewalk Boolean          @default(false) @map("suitable_for_sidewalk")
  suitableForPath     Boolean          @default(false) @map("suitable_for_path")
  availableAtNight    Boolean          @default(false) @map("available_at_night")
  availableOnRestDay  Boolean          @default(false) @map("available_on_rest_day")
  description         String?
  active              Boolean          @default(true)
  sortOrder           Int              @default(0) @map("sort_order")

  resources        Resource[]
  allowedOnStreets Street[]                    @relation("StreetAllowedResourceTypes")
  quotas           ContractAreaResourceQuota[]

  allowedAtWaterPoints WaterRefillPoint[]   @relation("WaterPointAllowedResourceTypes")
  allowedAtWastePoints WasteDisposalPoint[] @relation("WastePointAllowedResourceTypes")

  @@map("resource_types")
}

model Resource {
  id                 String         @id @default(cuid())
  resourceTypeId     String         @map("resource_type_id")
  resourceType       ResourceType   @relation(fields: [resourceTypeId], references: [id])
  identifier         String         // מספר רכב / מספר כלי
  name               String?
  assignedEmployeeId String?        @map("assigned_employee_id")
  assignedEmployee   User?          @relation("ResourceEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  status             ResourceStatus @default(ACTIVE)

  allowedZones   OperationalZone[] @relation("ResourceAllowedZones")
  allowedStreets Street[]          @relation("ResourceAllowedStreets")

  workHoursStart String? @map("work_hours_start") // "07:00"
  workHoursEnd   String? @map("work_hours_end")   // "14:30"

  attributes Json @default("{}") // שדות ייחודיים לפי סוג משאב (קיבולת, מהירות עבודה...)
  notes      String?
  active     Boolean @default(true)

  /// See OperationalZone.isDemo.
  isDemo Boolean @default(false) @map("is_demo")

  // ---- external tracking system (cameras / location), owned by a third party ----
  // Reference only. This application does not read from that system, does not
  // store any position or video, and must not be wired to it without a
  // documented, authorised API. See docs/smart-cleaning-routing.md.
  externalTrackingId  String? @map("external_tracking_id")
  externalTrackingUrl String? @map("external_tracking_url")
  trackingVendor      String? @map("tracking_vendor")

  availability  ResourceAvailability[]
  workPlanTasks WorkPlanTask[]
  telemetry     TelemetryEvent[]

  operationalProfile ResourceOperationalProfile?
  shiftReports       ShiftReport[]
  serviceStops       WorkPlanServiceStop[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([resourceTypeId, identifier])
  @@map("resources")
}

model ResourceAvailability {
  id                String              @id @default(cuid())
  resourceId        String              @map("resource_id")
  resource          Resource            @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  date              DateTime            @db.Date
  status            AvailabilityStatus  @default(AVAILABLE)
  reason            String?
  timeOverrideStart String?             @map("time_override_start")
  timeOverrideEnd   String?             @map("time_override_end")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([resourceId, date])
  @@index([date])
  @@map("resource_availability")
}

// ---------- Work plans ----------

model WorkPlan {
  id              String         @id @default(cuid())
  date            DateTime       @db.Date
  versionNumber   Int            @map("version_number")
  status          WorkPlanStatus @default(DRAFT)
  createdById     String         @map("created_by")
  createdBy       User           @relation("WorkPlanCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now()) @map("created_at")
  parentVersionId String?        @map("parent_version_id")
  parentVersion   WorkPlan?      @relation("WorkPlanVersions", fields: [parentVersionId], references: [id])
  childVersions   WorkPlan[]     @relation("WorkPlanVersions")

  // ---- smart routing (§10–§13) ----
  /// Which of the three offered alternatives the manager picked.
  variant String?
  /// The cost breakdown of the chosen route and of the ones rejected, so the
  /// question "why this route" is answerable months later, not just at the
  /// moment the screen was open.
  planningExplanation Json? @map("planning_explanation")
  /// Result of the pre-publish feasibility check. Publishing is blocked until
  /// this exists.
  feasibility Json?
  /// §13: a plan with a failing check may still be published, but only with a
  /// written reason and a named approver.
  overrideReason        String? @map("override_reason")
  overrideApprovedById  String? @map("override_approved_by")
  overrideApprovedBy    User?   @relation("PlanOverrideApprovedBy", fields: [overrideApprovedById], references: [id], onDelete: SetNull)

  /// §PLN-04: explicit cancellation, distinct from being superseded by a
  /// newer confirmed plan (see SUPERSEDED_SIBLING_PLANS in the audit log) —
  /// a manager retiring a plan on purpose always leaves a reason.
  cancelReason   String?   @map("cancel_reason")
  cancelledById  String?   @map("cancelled_by")
  cancelledBy    User?     @relation("PlanCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt    DateTime? @map("cancelled_at")

  tasks        WorkPlanTask[]
  changes      WorkPlanChange[]
  serviceStops WorkPlanServiceStop[]

  @@unique([date, versionNumber])
  @@index([date])
  @@map("work_plans")
}

model WorkPlanTask {
  id             String     @id @default(cuid())
  workPlanId     String     @map("work_plan_id")
  workPlan       WorkPlan   @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  resourceId     String     @map("resource_id")
  resource       Resource   @relation(fields: [resourceId], references: [id])
  streetId       String     @map("street_id")
  street         Street     @relation(fields: [streetId], references: [id])
  sequenceOrder  Int        @map("sequence_order")

  plannedStart DateTime @map("planned_start")
  plannedEnd   DateTime @map("planned_end")
  distanceM      Float?   @map("distance_m")
  travelTimeMin  Float?   @map("travel_time_min")
  cleanTimeMin   Float?   @map("clean_time_min")
  /// Whether distanceM came from the real OSM road-network graph or a
  /// straight-line fallback (graph lookup failed / disconnected component).
  /// Null for tasks planned before this field existed. Never show a
  /// STRAIGHT_LINE distance as a real road time — see docs/EXTERNAL_INTEGRATIONS.md.
  distanceBasis  DistanceBasis? @map("distance_basis")

  status TaskStatus @default(PENDING)

  actualStart    DateTime? @map("actual_start")
  actualEnd      DateTime? @map("actual_end")
  actualNotes    String?   @map("actual_notes")
  employeeComment String?  @map("employee_comment")

  /// Litres the engine expects this stop to consume, and the water level it
  /// projects on arrival. Both null when no water profile exists for the
  /// vehicle — the plan then simply carries no water projection rather than a
  /// made-up one.
  plannedWaterLiters    Float?    @map("planned_water_liters")
  projectedWaterAfterL  Float?    @map("projected_water_after_l")
  waterBasis            CalcBasis? @map("water_basis")
  /// Same idea as the water pair above, for the waste tank: kg this task adds
  /// and the headroom left in the tank afterward. Negative headroom is an
  /// overflow the feasibility check must block on (see feasibility.ts).
  plannedWasteKg        Float? @map("planned_waste_kg")
  projectedWasteAfterKg Float? @map("projected_waste_after_kg")
  /// Dirt score at the moment the plan was built, frozen so a later rescore
  /// cannot silently restate why this street was picked.
  dirtScoreAtPlanning Float? @map("dirt_score_at_planning")

  cleaningLogs StreetCleaningLog[]
  fieldReports TaskFieldReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workPlanId])
  @@index([resourceId])
  @@index([streetId])
  @@map("work_plan_tasks")
}

model WorkPlanChange {
  id          String   @id @default(cuid())
  workPlanId  String   @map("work_plan_id")
  workPlan    WorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  changedById String   @map("changed_by")
  changedBy   User     @relation("WorkPlanChangeBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now()) @map("changed_at")
  changeType  String   @map("change_type")
  before      Json?
  after       Json?
  description String?

  @@index([workPlanId])
  @@map("work_plan_changes")
}

model StreetCleaningLog {
  id             String        @id @default(cuid())
  streetId       String        @map("street_id")
  street         Street        @relation(fields: [streetId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  workPlanTaskId String?       @map("work_plan_task_id")
  workPlanTask   WorkPlanTask? @relation(fields: [workPlanTaskId], references: [id], onDelete: SetNull)
  completed      Boolean       @default(false)

  @@index([streetId, date])
  @@map("street_cleaning_log")
}

// ---------- Future GPS / Ituran integration (schema-ready, unused in phase 1) ----------

model TelemetryEvent {
  id         String   @id @default(cuid())
  resourceId String   @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  timestamp  DateTime
  lat        Float
  lon        Float
  speed      Float?
  source     String   @default("manual")

  @@index([resourceId, timestamp])
  @@map("telemetry_events")
}

// ---------- Import tracking ----------

model ImportBatch {
  id           String       @id @default(cuid())
  type         ImportType
  filename     String
  uploadedById String       @map("uploaded_by")
  uploadedBy   User         @relation("ImportedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")
  rowCount     Int          @map("row_count")
  status       ImportStatus @default(PENDING)
  errorLog     Json?        @map("error_log")

  @@map("import_batches")
}

// ---------- Provenance, conflicts and audit ----------

/// Where one extracted value came from. Attached polymorphically so any entity
/// can carry provenance without a foreign key per table.
model SourceEvidence {
  id String @id @default(cuid())

  entityType String  @map("entity_type") // "ContractArea", "OperationalZone", ...
  entityId   String  @map("entity_id")
  fieldName  String? @map("field_name")

  sourceFile        String     @map("source_file")
  sourceType        SourceType @map("source_type")
  sourcePage        Int?       @map("source_page")
  sourceSection     String?    @map("source_section")
  sourceImageRegion String?    @map("source_image_region")

  extractedValue String? @map("extracted_value")

  confidence         ConfidenceLevel    @default(MEDIUM)
  verificationStatus VerificationStatus @default(EXTRACTED) @map("verification_status")

  verifiedById String?   @map("verified_by")
  verifiedBy   User?     @relation("EvidenceVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime? @map("verified_at")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([verificationStatus])
  @@map("source_evidence")
}

/// Two or more sources that disagree. Both values are kept; a manager decides.
/// Never silently resolved by picking a number.
model SourceConflict {
  id    String @id @default(cuid())
  topic String

  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")
  fieldName  String? @map("field_name")

  valueA  String @map("value_a")
  sourceA String @map("source_a")
  valueB  String @map("value_b")
  sourceB String @map("source_b")
  valueC  String? @map("value_c")
  sourceC String? @map("source_c")

  status ConflictStatus @default(OPEN)

  resolvedValue String?   @map("resolved_value")
  resolvedById  String?   @map("resolved_by")
  resolvedBy    User?     @relation("ConflictResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt    DateTime? @map("resolved_at")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("source_conflicts")
}

/// A human correction that automated recomputation must respect.
model ManualOverride {
  id String @id @default(cuid())

  entityType String @map("entity_type")
  entityId   String @map("entity_id")
  fieldName  String @map("field_name")

  previousValue String? @map("previous_value")
  newValue      String? @map("new_value")
  reason        String?

  overriddenById String   @map("overridden_by")
  overriddenBy   User     @relation("OverrideBy", fields: [overriddenById], references: [id])
  overriddenAt   DateTime @default(now()) @map("overridden_at")

  @@index([entityType, entityId])
  @@map("manual_overrides")
}

// ---------- Defects, complaints and inspection ----------

/// One row of the tender's agreed-deduction table (טבלה 15).
/// `deductionAmount` is what the contract says a single occurrence costs; the
/// wording of what counts as "one occurrence" differs per row and is preserved
/// verbatim in `unitBasis` rather than being normalised away.
model DefectType {
  id   String @id @default(cuid())
  code String @unique
  name String

  deductionAmount Decimal @map("deduction_amount") @db.Decimal(12, 2)
  unitBasis       String  @map("unit_basis")
  category        String

  /// Default hours the contractor gets to fix this, used to seed Defect.dueAt.
  defaultFixHours Int? @map("default_fix_hours")

  sourceSection String? @map("source_section")
  active        Boolean @default(true)
  sortOrder     Int     @default(0)
  notes         String?

  defects Defect[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("defect_types")
}

model Defect {
  id       String @id @default(cuid())
  /// Short human reference shown in the field, e.g. "LK-2026-0042".
  reference String @unique

  defectTypeId String?     @map("defect_type_id")
  defectType   DefectType? @relation(fields: [defectTypeId], references: [id], onDelete: SetNull)

  zoneId    String?          @map("zone_id")
  zone      OperationalZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  streetId  String?          @map("street_id")
  street    Street?          @relation(fields: [streetId], references: [id], onDelete: SetNull)
  segmentId String?          @map("segment_id")
  segment   StreetSegment?   @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  /// Denormalised so a defect keeps pointing at the responsible contractor even
  /// if the zone is later reassigned to the other contract area.
  contractAreaId String?       @map("contract_area_id")
  contractArea   ContractArea? @relation(fields: [contractAreaId], references: [id], onDelete: SetNull)

  /// Point dropped on the map. Kept as plain lat/lon: a defect is a single
  /// pin, so it needs no PostGIS geometry or spatial index.
  lat Float?
  lon Float?

  title       String
  description String?
  severity    DefectSeverity @default(MEDIUM)
  origin      DefectOrigin   @default(INSPECTION)
  status      DefectStatus   @default(NEW)

  reportedById String @map("reported_by")
  reportedBy   User   @relation("DefectReportedBy", fields: [reportedById], references: [id])
  assignedToId String? @map("assigned_to")
  assignedTo   User?  @relation("DefectAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  reportedAt DateTime  @default(now()) @map("reported_at")
  dueAt      DateTime? @map("due_at")
  fixedAt    DateTime? @map("fixed_at")
  closedAt   DateTime? @map("closed_at")

  /// Why the work was not done, when the contractor rejects or cannot comply.
  notDoneReason String? @map("not_done_reason")
  inspectorNotes String? @map("inspector_notes")

  // ---- deduction (§822, §825) ----
  deductionStatus DeductionStatus @default(NONE) @map("deduction_status")
  /// Proposed amount, copied from the defect type at creation so a later change
  /// to the catalog cannot silently restate a historical charge.
  deductionAmount Decimal? @map("deduction_amount") @db.Decimal(12, 2)
  /// §822: where the municipality carried out the fix itself, it may add 15%.
  deductionSurchargePercent Int? @map("deduction_surcharge_percent")
  deductionReason           String? @map("deduction_reason")
  deductionApprovedById     String? @map("deduction_approved_by")
  deductionApprovedBy       User?   @relation("DeductionApprovedBy", fields: [deductionApprovedById], references: [id], onDelete: SetNull)
  deductionApprovedAt       DateTime? @map("deduction_approved_at")

  // ---- appeal (§826: 7 days to appeal, 14 days to decide) ----
  appealText       String?   @map("appeal_text")
  appealedAt       DateTime? @map("appealed_at")
  appealDueAt      DateTime? @map("appeal_due_at")
  appealDecision   String?   @map("appeal_decision")
  appealDecidedAt  DateTime? @map("appeal_decided_at")
  appealDecidedById String?  @map("appeal_decided_by")
  appealDecidedBy  User?     @relation("AppealDecidedBy", fields: [appealDecidedById], references: [id], onDelete: SetNull)

  inspectionId String?     @map("inspection_id")
  inspection   Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  complaintId  String?     @map("complaint_id")
  complaint    Complaint?  @relation(fields: [complaintId], references: [id], onDelete: SetNull)

  photos DefectPhoto[]
  events DefectEvent[]
  /// Field reports that raised this defect from /my-day — see TaskFieldReport.defectId.
  fieldReportLinks TaskFieldReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([zoneId])
  @@index([contractAreaId])
  @@index([dueAt])
  @@map("defects")
}

/// Before/after evidence. Bytes live in the database and are served through an
/// authenticated route rather than from /public, so a photo of a site is not
/// readable by anyone who guesses the URL.
model DefectPhoto {
  id       String @id @default(cuid())
  defectId String @map("defect_id")
  defect   Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)

  kind     PhotoKind
  mimeType String    @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  data     Bytes
  caption  String?

  uploadedById String   @map("uploaded_by")
  uploadedBy   User     @relation("PhotoUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  @@index([defectId])
  @@map("defect_photos")
}

/// Append-only history. Nothing here is ever edited or deleted — the contract
/// makes the defect trail evidence in a payment dispute.
model DefectEvent {
  id       String @id @default(cuid())
  defectId String @map("defect_id")
  defect   Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)

  action     String
  fromStatus DefectStatus? @map("from_status")
  toStatus   DefectStatus? @map("to_status")
  note       String?

  userId String? @map("user_id")
  user   User?   @relation("DefectEventBy", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([defectId, createdAt])
  @@map("defect_events")
}

/// §640: every resident complaint the contractor must investigate and handle.
model Complaint {
  id        String @id @default(cuid())
  reference String @unique

  /// Kept minimal on purpose — a name and a callback number are all the
  /// operation needs, so no further personal data is stored.
  reporterName  String? @map("reporter_name")
  reporterPhone String? @map("reporter_phone")

  zoneId   String?          @map("zone_id")
  zone     OperationalZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  streetId String?          @map("street_id")
  street   Street?          @relation(fields: [streetId], references: [id], onDelete: SetNull)
  lat      Float?
  lon      Float?

  subject     String
  description String?
  status      ComplaintStatus @default(NEW)

  receivedAt DateTime  @default(now()) @map("received_at")
  dueAt      DateTime? @map("due_at")
  resolvedAt DateTime? @map("resolved_at")
  resolution String?

  receivedById String  @map("received_by")
  receivedBy   User    @relation("ComplaintReceivedBy", fields: [receivedById], references: [id])
  assignedToId String? @map("assigned_to")
  assignedTo   User?   @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  defects Defect[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([zoneId])
  @@map("complaints")
}

/// §561: a joint field tour, municipal inspector plus the contractor's site
/// supervisor, twice a day at 10:00 and 12:00.
model Inspection {
  id   String   @id @default(cuid())
  date DateTime @db.Date
  round InspectionRound @default(MORNING_10)

  zoneId String?          @map("zone_id")
  zone   OperationalZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  inspectorId String @map("inspector_id")
  inspector   User   @relation("InspectionInspector", fields: [inspectorId], references: [id])
  /// The contractor's site supervisor who attended, per §561.
  contractorRepId String? @map("contractor_rep")
  contractorRep   User?   @relation("InspectionContractorRep", fields: [contractorRepId], references: [id], onDelete: SetNull)

  status      InspectionStatus @default(PLANNED)
  meetingPoint String?         @map("meeting_point")
  startedAt   DateTime?        @map("started_at")
  completedAt DateTime?        @map("completed_at")
  notes       String?

  defects Defect[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([date, round, zoneId])
  @@index([date])
  @@map("inspections")
}

model AuditLog {
  id String @id @default(cuid())

  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")
  action     String

  userId String? @map("user_id")
  user   User?   @relation("AuditBy", fields: [userId], references: [id], onDelete: SetNull)

  before      Json?
  after       Json?
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- Smart cleaning: settings ----------

/// Operator-editable configuration. Lives in the database rather than in the
/// environment specifically because §2 and §11 require a manager to be able to
/// change the scoring weights and the route cost weights from a screen — a
/// value nobody can change without a redeploy is not a setting.
model SystemSetting {
  key         String  @id
  value       Json
  description String?

  updatedById String? @map("updated_by")
  updatedBy   User?   @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ---------- Smart cleaning: street/path profile and survey ----------

/// Everything about how a street or path actually behaves that the planner
/// needs and the geometry cannot tell it: how fast it gets dirty, how long it
/// really takes to clean, whether a vehicle fits, how much water it drinks.
///
/// Kept off `Street` itself so that (a) the table with 1000s of imported OSM
/// rows takes no new NOT NULL columns, and (b) "we have no profile for this
/// street" stays a distinguishable state from "the profile says zero".
model StreetCleaningProfile {
  id       String @id @default(cuid())
  streetId String @unique @map("street_id")
  street   Street @relation(fields: [streetId], references: [id], onDelete: Cascade)

  // ---- physical ----
  /// Free text beyond Street.type: מדרכה, גן ציבורי, שצ"פ, אזור מסחרי, אזור תעשייה.
  infrastructureKind String? @map("infrastructure_kind")
  widthM             Float?  @map("width_m")
  areaM2             Float?  @map("area_m2")

  // ---- dirt ----
  /// 1–5, the supervisor's baseline judgement from the field survey.
  dirtBaseLevel Int? @map("dirt_base_level")
  /// 1–5, the moving average of what crews actually reported on arrival.
  dirtDynamicLevel Float? @map("dirt_dynamic_level")

  /// Same shape as Street.cleaningFrequency, but this is the *recommendation*,
  /// not the schedule in force — the two are allowed to disagree, and that
  /// disagreement is exactly what the manager should see.
  recommendedFrequency Json? @map("recommended_frequency")

  // ---- time ----
  plannedCleanMin   Float?    @map("planned_clean_min")
  avgActualCleanMin Float?    @map("avg_actual_clean_min")
  lastCleanedAt     DateTime? @map("last_cleaned_at")

  // ---- context that drives the score ----
  pedestrianTraffic Int?     @map("pedestrian_traffic") // 1–5
  nearSchool        Boolean? @map("near_school")
  nearCommerce      Boolean? @map("near_commerce")
  nearBusStop       Boolean? @map("near_bus_stop")
  binCount          Int?     @map("bin_count")
  treeCount         Int?     @map("tree_count")
  leafFallLevel     Int?     @map("leaf_fall_level") // 1–5
  /// { "9": 4, "10": 5, "11": 5 } — month (1–12) → sensitivity 1–5.
  seasonalSensitivity Json? @map("seasonal_sensitivity")
  /// Free text: a school fair, a market day, roadworks.
  specialEvents String? @map("special_events")

  // ---- water ----
  requiresWater         Boolean @default(false) @map("requires_water")
  estWaterLitersPer100m Float?  @map("est_water_liters_per_100m")
  usesPressureWash      Boolean @default(false) @map("uses_pressure_wash")

  preferredWaterPointId String?           @map("preferred_water_point_id")
  preferredWaterPoint   WaterRefillPoint? @relation("PreferredWaterPoint", fields: [preferredWaterPointId], references: [id], onDelete: SetNull)
  preferredWastePointId String?             @map("preferred_waste_point_id")
  preferredWastePoint   WasteDisposalPoint? @relation("PreferredWastePoint", fields: [preferredWastePointId], references: [id], onDelete: SetNull)

  // ---- access ----
  accessIssue   Boolean @default(false) @map("access_issue")
  narrowRoad    Boolean @default(false) @map("narrow_road")
  /// [{"from":"07:00","to":"08:30","reason":"יציאת בית ספר"}]
  blockedHours     Json?   @map("blocked_hours")
  permanentHazards String? @map("permanent_hazards")

  supervisorNote String? @map("supervisor_note")

  // ---- score (§2) ----
  dirtScore Float? @map("dirt_score") // 0–100
  /// Per-component raw value, weight and contribution. The explanation shown
  /// to the manager is rendered from this, never re-derived at display time.
  dirtScoreFactors Json?     @map("dirt_score_factors")
  dirtScoreAt      DateTime? @map("dirt_score_at")

  dataMode    ProfileDataMode @default(REQUIRES_REVIEW) @map("data_mode")
  confidence  ConfidenceLevel @default(LOW)
  sampleCount Int             @default(0) @map("sample_count")

  /// Set when a manager edits a learned field by hand. Learning must not
  /// overwrite such a field on a later run.
  manuallyOverridden Boolean @default(false) @map("manually_overridden")
  /// Which specific fields were hand-set, e.g. ["avgActualCleanMin"].
  manuallyOverriddenFields String[] @default([]) @map("manually_overridden_fields")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dirtScore])
  @@index([dataMode])
  @@index([lastCleanedAt])
  @@map("street_cleaning_profiles")
}

/// §3: one submission of the field survey. Append-only — a re-survey adds a
/// row rather than editing the last one, so a profile's history of judgements
/// stays readable.
model StreetSurvey {
  id       String @id @default(cuid())
  streetId String @map("street_id")
  street   Street @relation(fields: [streetId], references: [id], onDelete: Cascade)

  surveyedById String @map("surveyed_by")
  surveyedBy   User   @relation("SurveyBy", fields: [surveyedById], references: [id])

  /// The raw answers exactly as submitted, so the derived profile can always
  /// be recomputed and audited against what the surveyor actually said.
  answers  Json
  progress SurveyProgress @default(COMPLETED)
  notes    String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([streetId, createdAt])
  @@index([progress])
  @@map("street_surveys")
}

// ---------- Smart cleaning: water and waste service points ----------

model WaterRefillPoint {
  id      String  @id @default(cuid())
  name    String
  lat     Float
  lon     Float
  address String?

  zoneId String?          @map("zone_id")
  zone   OperationalZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  status ServicePointStatus @default(REQUIRES_REVIEW)

  /// [{"day":"SUN","from":"06:00","to":"18:00"}]; null = no restriction known.
  availabilityHours Json?   @map("availability_hours")
  connectionType    String? @map("connection_type")

  flowLitersPerMin Float? @map("flow_liters_per_min")
  avgFillMinutes   Float? @map("avg_fill_minutes")
  avgWaitMinutes   Float? @map("avg_wait_minutes")
  /// How many vehicles can fill at once. 1 unless someone confirms otherwise.
  parallelCapacity Int    @default(1) @map("parallel_capacity")

  maxVehicleWidthM  Float? @map("max_vehicle_width_m")
  maxVehicleHeightM Float? @map("max_vehicle_height_m")

  contactName   String?   @map("contact_name")
  contactPhone  String?   @map("contact_phone")
  lastCheckedAt DateTime? @map("last_checked_at")

  verificationStatus VerificationStatus @default(REQUIRES_REVIEW) @map("verification_status")
  confidence         ConfidenceLevel    @default(LOW)
  sourceType         SourceType         @default(MANUAL_ENTRY) @map("source_type")
  notes              String?
  active             Boolean            @default(true)
  isDemo             Boolean            @default(false) @map("is_demo")

  allowedResourceTypes ResourceType[]          @relation("WaterPointAllowedResourceTypes")
  preferredByProfiles  StreetCleaningProfile[] @relation("PreferredWaterPoint")
  serviceStops         WorkPlanServiceStop[]
  fieldReports         TaskFieldReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([zoneId, status])
  @@index([verificationStatus])
  @@map("water_refill_points")
}

model WasteDisposalPoint {
  id      String  @id @default(cuid())
  name    String
  lat     Float
  lon     Float
  address String?

  zoneId String?          @map("zone_id")
  zone   OperationalZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  /// Free-text tags kept as written (e.g. "גזם", "אשפה יבשה") rather than an
  /// enum — the accepted list differs per site and is not fixed by contract.
  allowedWasteTypes String[] @default([]) @map("allowed_waste_types")

  availabilityHours Json?  @map("availability_hours")
  avgDumpMinutes    Float? @map("avg_dump_minutes")
  avgWaitMinutes    Float? @map("avg_wait_minutes")

  maxVehicleWidthM  Float?  @map("max_vehicle_width_m")
  maxVehicleHeightM Float?  @map("max_vehicle_height_m")
  accessNotes       String? @map("access_notes")

  status             ServicePointStatus @default(REQUIRES_REVIEW)
  verificationStatus VerificationStatus @default(REQUIRES_REVIEW) @map("verification_status")
  confidence         ConfidenceLevel    @default(LOW)
  notes              String?
  active             Boolean            @default(true)
  isDemo             Boolean            @default(false) @map("is_demo")

  allowedResourceTypes ResourceType[]          @relation("WastePointAllowedResourceTypes")
  preferredByProfiles  StreetCleaningProfile[] @relation("PreferredWastePoint")
  serviceStops         WorkPlanServiceStop[]
  fieldReports         TaskFieldReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([zoneId, status])
  @@map("waste_disposal_points")
}

// ---------- Smart cleaning: vehicle operational profile ----------

/// §6. Every figure is nullable on purpose: a missing capacity must read as
/// REQUIRES_REVIEW in the UI, never as a plausible default silently used by
/// the water projection. `Resource.attributes` keeps working as the older,
/// looser store and is used as a fallback.
model ResourceOperationalProfile {
  id         String   @id @default(cuid())
  resourceId String   @unique @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  // ---- capacity ----
  waterCapacityL   Float? @map("water_capacity_l")
  wasteCapacityKg  Float? @map("waste_capacity_kg")
  minWaterReserveL Float? @map("min_water_reserve_l")

  // ---- consumption ----
  waterLPerWorkHour Float? @map("water_l_per_work_hour")
  waterLPerCleanKm  Float? @map("water_l_per_clean_km")
  wasteKgPerCleanKm Float? @map("waste_kg_per_clean_km")

  // ---- dimensions / access ----
  widthM             Float?  @map("width_m")
  heightM            Float?  @map("height_m")
  weightKg           Float?  @map("weight_kg")
  canEnterPath       Boolean @default(false) @map("can_enter_path")
  canMountSidewalk   Boolean @default(false) @map("can_mount_sidewalk")
  /// Free text list of road types it may work on, beyond the type catalog.
  allowedRoadTypes String[] @default([]) @map("allowed_road_types")

  // ---- speed and service times ----
  avgWorkSpeedMPerMin Float? @map("avg_work_speed_m_per_min")
  avgTravelSpeedKmh   Float? @map("avg_travel_speed_kmh")
  avgFillMinutes      Float? @map("avg_fill_minutes")
  avgDumpMinutes      Float? @map("avg_dump_minutes")

  // ---- depot ----
  startPointLat Float? @map("start_point_lat")
  startPointLon Float? @map("start_point_lon")
  endPointLat   Float? @map("end_point_lat")
  endPointLon   Float? @map("end_point_lon")

  verificationStatus VerificationStatus @default(REQUIRES_REVIEW) @map("verification_status")
  confidence         ConfidenceLevel    @default(LOW)
  sampleCount        Int                @default(0) @map("sample_count")
  notes              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("resource_operational_profiles")
}

// ---------- Smart cleaning: field reporting ----------

/// §7: what the driver states at the start of the shift. The water level here
/// is the only trustworthy starting point for the day's projection — there is
/// no tank sensor and none is to be simulated.
model ShiftReport {
  id         String   @id @default(cuid())
  resourceId String   @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation("ShiftReportBy", fields: [userId], references: [id])

  date      DateTime @db.Date
  startedAt DateTime @map("started_at")

  operatorName  String? @map("operator_name")
  licensePlate  String? @map("license_plate")

  waterStartPercent Int?   @map("water_start_percent")
  waterStartLiters  Float? @map("water_start_liters")
  wasteTankState    String? @map("waste_tank_state")
  vehicleCondition  String? @map("vehicle_condition")

  /// Only recorded when the browser granted permission and the user submitted
  /// it with the form. Not tracking — a single point at shift start.
  lat Float?
  lon Float?

  notes  String?
  isDemo Boolean @default(false) @map("is_demo")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([resourceId, date])
  @@index([date])
  @@map("shift_reports")
}

/// §8: what actually happened on one street. This is the single input the
/// learning layer trains on, and the only evidence for plan-vs-actual — there
/// is no GPS trace to fall back on.
model TaskFieldReport {
  id             String       @id @default(cuid())
  workPlanTaskId String       @map("work_plan_task_id")
  workPlanTask   WorkPlanTask @relation(fields: [workPlanTaskId], references: [id], onDelete: Cascade)

  reportedById String @map("reported_by")
  reportedBy   User   @relation("FieldReportBy", fields: [reportedById], references: [id])

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  dirtBefore  Int? @map("dirt_before")  // 1–5
  cleanAfter  Int? @map("clean_after")  // 1–5

  waterBeforeL       Float? @map("water_before_l")
  waterAfterL        Float? @map("water_after_l")
  waterBeforePercent Int?   @map("water_before_percent")
  waterAfterPercent  Int?   @map("water_after_percent")

  refillNeeded        Boolean           @default(false) @map("refill_needed")
  waterRefillPointId  String?           @map("water_refill_point_id")
  waterRefillPoint    WaterRefillPoint? @relation(fields: [waterRefillPointId], references: [id], onDelete: SetNull)
  refillMinutes       Float?            @map("refill_minutes")
  refillTravelMinutes Float?            @map("refill_travel_minutes")

  wasteDumpNeeded      Boolean             @default(false) @map("waste_dump_needed")
  wasteDisposalPointId String?             @map("waste_disposal_point_id")
  wasteDisposalPoint   WasteDisposalPoint? @relation(fields: [wasteDisposalPointId], references: [id], onDelete: SetNull)
  dumpMinutes          Float?              @map("dump_minutes")

  accessProblem   Boolean @default(false) @map("access_problem")
  parkedVehicles  Boolean @default(false) @map("parked_vehicles")
  blocked         Boolean @default(false)
  vehicleSuitable Boolean @default(true) @map("vehicle_suitable")
  needsRevisit    Boolean @default(false) @map("needs_revisit")

  /// A structured reason for NOT_DONE/PROBLEM statuses — the booleans above
  /// capture *what* happened, this captures *why the task wasn't completed*,
  /// in a form reports can group by instead of parsing free text.
  nonCompletionReason NonCompletionReason? @map("non_completion_reason")
  /// Optional shortcut from a field report straight into the Defects module,
  /// so a worker who spots a defect while on a task does not have to leave
  /// /my-day and re-describe it from scratch.
  defectId String? @map("defect_id")
  defect   Defect? @relation(fields: [defectId], references: [id], onDelete: SetNull)

  notes String?

  /// Client-generated per-submit-attempt key so a retried save on a flaky
  /// field connection creates/updates one report instead of a duplicate and
  /// double-applying the EWMA learning update (see updateFromExecution.ts).
  idempotencyKey String? @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workPlanTaskId])
  @@index([createdAt])
  @@map("task_field_reports")
}

/// Field photos, attached polymorphically the same way SourceEvidence is, so
/// shift reports and survey answers can both carry pictures without a foreign
/// key per table. Bytes live in the database and are served through an
/// authenticated route, exactly like DefectPhoto — never written to /public.
model FieldPhoto {
  id String @id @default(cuid())

  entityType String @map("entity_type") // "ShiftReport" | "TaskFieldReport" | "StreetSurvey" | "WaterRefillPoint" ...
  entityId   String @map("entity_id")

  kind      FieldPhotoKind @default(GENERAL)
  mimeType  String         @map("mime_type")
  sizeBytes Int            @map("size_bytes")
  data      Bytes
  caption   String?

  uploadedById String   @map("uploaded_by")
  uploadedBy   User     @relation("FieldPhotoUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  @@index([entityType, entityId])
  @@map("field_photos")
}

// ---------- Smart cleaning: service stops inside a route ----------

/// A refill or disposal stop the engine inserted into a resource's day.
///
/// Deliberately a separate table rather than a nullable `street_id` on
/// work_plan_tasks: every existing report, dashboard query and screen keeps
/// seeing exactly the cleaning tasks it saw before, and only the new views
/// merge the two lists by `sequenceOrder`.
model WorkPlanServiceStop {
  id         String   @id @default(cuid())
  workPlanId String   @map("work_plan_id")
  workPlan   WorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  resourceId String   @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id])

  /// Shares the numbering space with WorkPlanTask.sequenceOrder for the same
  /// resource, which is what lets the two be merged into one route.
  sequenceOrder Int             @map("sequence_order")
  kind          ServiceStopKind

  waterRefillPointId   String?             @map("water_refill_point_id")
  waterRefillPoint     WaterRefillPoint?   @relation(fields: [waterRefillPointId], references: [id], onDelete: SetNull)
  wasteDisposalPointId String?             @map("waste_disposal_point_id")
  wasteDisposalPoint   WasteDisposalPoint? @relation(fields: [wasteDisposalPointId], references: [id], onDelete: SetNull)

  plannedArrival   DateTime @map("planned_arrival")
  plannedDeparture DateTime @map("planned_departure")
  travelDistanceM  Float?   @map("travel_distance_m")
  travelTimeMin    Float?   @map("travel_time_min")
  serviceTimeMin   Float?   @map("service_time_min")
  litersLoaded     Float?   @map("liters_loaded")

  /// Why the engine put this stop here, in the manager's language.
  reason String?
  basis  CalcBasis @default(ESTIMATED)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workPlanId, resourceId])
  @@map("work_plan_service_stops")
}

// ---------- Smart cleaning: learning from execution ----------

/// §17: one recorded change to a learned figure. Keeping the old value next to
/// the new one is what makes "why did the estimate move" answerable, and what
/// lets a manager void a bad sample and have the average recomputed without it.
model ProfileLearningEvent {
  id String @id @default(cuid())

  entityType String @map("entity_type") // "StreetCleaningProfile" | "ResourceOperationalProfile" | "WaterRefillPoint"
  entityId   String @map("entity_id")
  fieldName  String @map("field_name")

  oldValue    Float?  @map("old_value")
  newValue    Float?  @map("new_value")
  sampleValue Float?  @map("sample_value")
  sampleCount Int     @default(0) @map("sample_count")
  reason      String?

  sourceReportId String? @map("source_report_id")

  /// True when the sample was outside the plausible band, or a manager voided
  /// it. Excluded samples are kept, not deleted — they are evidence too.
  excluded     Boolean   @default(false)
  excludedById String?   @map("excluded_by")
  excludedBy   User?     @relation("LearningSampleExcludedBy", fields: [excludedById], references: [id], onDelete: SetNull)
  excludedAt   DateTime? @map("excluded_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([excluded])
  @@map("profile_learning_events")
}
